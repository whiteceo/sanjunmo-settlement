{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sanjunmo.local/engine/schema/output.schema.json",
  "title": "정산엔진 기준 계산기 출력 (한 정산월)",
  "description": "engine/SPEC.md 기준. 단계 코드는 정본 그대로(CARRY_IN … PAYOUT). 필드 출처 표기는 input.schema.json과 같다. 단계 결과 필드 대부분은 [신규 명명](정본 표기를 영문화)이며 description에 정본 명칭을 적는다.",
  "type": "object",
  "required": ["settlement_month", "engine_version", "rights_holders", "trace", "continuity"],
  "$defs": {
    "money": { "oneOf": [{ "type": "integer" }, { "type": "string", "pattern": "^-?[0-9]+(\\.[0-9]{1,8})?$" }] },
    "step_code": { "type": "string", "enum": ["PIPELINE_IN", "CARRY_IN", "ACCRUAL", "MMG_ADJ", "DEDUCT", "SUPPORT_CAP", "PREPAY_OFFSET", "LUMPSUM_ADD", "PAYEE_SPLIT", "TAX", "CLAIM", "PAYOUT", "CLOSE_CHECK"] },
    "line_key": {
      "description": "SPEC 1절 라인 키.",
      "type": "object",
      "properties": {
        "contract_id": { "type": "string" }, "pipeline_id": { "type": "string" },
        "rate_type": { "type": ["string", "null"] }, "agreement_id": { "type": ["string", "null"] },
        "approval_id": { "type": ["string", "null"], "description": "milestone_id 등" },
        "income_category": { "type": ["string", "null"] }, "income_clause": { "type": ["string", "null"] },
        "tax_threshold_unit_key": { "type": ["string", "null"] }
      }
    },
    "trace_row": {
      "type": "object",
      "required": ["step", "step_code", "inputs", "formula", "result", "canon_ref"],
      "properties": {
        "step": { "type": "integer", "minimum": 0, "maximum": 12, "description": "표시 순번(0=상위 인입, 12=마감 검증)" },
        "step_code": { "$ref": "#/$defs/step_code" },
        "scope": {
          "type": "object",
          "properties": {
            "rights_holder_id": { "type": "string" }, "contract_id": { "type": ["string", "null"] },
            "payee_id": { "type": ["string", "null"] }, "line_key": { "$ref": "#/$defs/line_key" },
            "agreement_id": { "type": ["string", "null"] }, "ref_id": { "type": ["string", "null"], "description": "원거래 · 승인 · 원장 식별자" }
          }
        },
        "inputs": { "type": "object", "description": "이 계산에 쓴 입력값(이름: 값)" },
        "formula": { "type": "string", "description": "정본 표기 그대로" },
        "formula_code": { "type": "string", "description": "SPEC 의사코드" },
        "before_rounding": { "oneOf": [{ "$ref": "#/$defs/money" }, { "type": "null" }] },
        "rounding": { "type": "string", "enum": ["NONE", "Q4", "FLOOR_WON", "ALLOC_LAST_REMAINDER", "ABS_FLOOR_SIGN"] },
        "result": {},
        "canon_ref": { "type": "string", "description": "예: V2 §8.3 5단계 3) L209" },
        "provisional": { "type": "boolean", "default": false, "description": "정본 확인 필요 잠정 규칙 사용 여부" },
        "note": { "type": "string", "description": "잠정이면 SPEC 16절 질문 번호(Q-xx)" }
      }
    },
    "carry_row_out": {
      "description": "[01-T] carryover_ledger 행(신규 적재 · 상태 전이 예정).",
      "type": "object",
      "properties": {
        "ledger_id": { "type": ["string", "null"] }, "action": { "type": "string", "enum": ["NEW", "RESERVE", "SETTLE", "RELEASE", "REDUCE", "KEEP"] },
        "rights_holder_id": { "type": "string" }, "payee_id": { "type": ["string", "null"] }, "contract_id": { "type": "string" },
        "origin_month": { "type": "string" }, "account_type": { "type": ["string", "null"], "enum": ["PRE_TAX", "POST_TAX", null] },
        "pipeline_id": { "type": "string" }, "consignment_balance_yn": { "type": "boolean" },
        "income_category": { "type": ["string", "null"] }, "income_clause": { "type": ["string", "null"] }, "tax_threshold_unit_key": { "type": ["string", "null"] },
        "carryover_reason": { "type": "string" }, "carryover_amount": { "$ref": "#/$defs/money" },
        "components": { "type": "object", "description": "[신규 명명] 원금 · 구성요소 보존(SPEC Q-21)" },
        "first_occurred_month": { "type": ["string", "null"] }, "first_payable_confirmed_month": { "type": ["string", "null"] },
        "payout_reservation_status": { "type": "string", "enum": ["NONE", "RESERVED", "SETTLED"] },
        "extinguished_yn": { "type": "boolean" }, "extinguished_month": { "type": ["string", "null"] }
      }
    },
    "line_amount": {
      "type": "object",
      "properties": { "line_key": { "$ref": "#/$defs/line_key" }, "amount": { "$ref": "#/$defs/money" } }
    }
  },
  "properties": {
    "settlement_month": { "type": "string" },
    "engine_version": { "type": "string" },
    "canon_version": { "type": "string", "description": "정본 문서 버전 · 커밋" },
    "run_reason": { "type": "string" },
    "status": { "type": "string", "enum": ["OK", "INPUT_ERROR", "LOCKED_MONTH", "BLOCKED_PENDING_REVIEW"] },
    "errors": { "type": "array", "items": { "type": "object", "properties": { "code": { "type": "string" }, "message": { "type": "string" }, "canon_ref": { "type": "string" } } } },
    "warnings": { "type": "array", "items": { "type": "object", "properties": { "code": { "type": "string" }, "message": { "type": "string" }, "canon_ref": { "type": "string" } } } },
    "rights_holders": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rights_holder_id", "contracts"],
        "properties": {
          "rights_holder_id": { "type": "string" },
          "is_internal": { "type": "boolean" },
          "contracts": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["contract_id", "steps", "payees"],
              "properties": {
                "contract_id": { "type": "string" },
                "steps": {
                  "type": "object",
                  "properties": {
                    "CARRY_IN": {
                      "type": "object",
                      "properties": {
                        "carry_pre_tax_pos": { "type": "array", "items": { "$ref": "#/$defs/carry_row_out" }, "description": "원귀속 세전 미지급 소득 배열" },
                        "carry_pre_tax_neg": { "type": "array", "items": { "$ref": "#/$defs/carry_row_out" }, "description": "세전 미확정 조정액 배열" },
                        "carry_post_tax_pos": { "type": "array", "items": { "$ref": "#/$defs/carry_row_out" }, "description": "세후 지급대기액" },
                        "carry_post_tax_neg": { "type": "array", "items": { "$ref": "#/$defs/carry_row_out" }, "description": "세후 반환채권" },
                        "consignment_balance": { "$ref": "#/$defs/money", "description": "위탁 전용 잔액" }
                      }
                    },
                    "ACCRUAL": {
                      "type": "object",
                      "properties": {
                        "new_lines": { "type": "array", "items": { "$ref": "#/$defs/line_amount" }, "description": "정산 입력 구분별 · 라인별 신규 세전액" },
                        "accrual_total": { "$ref": "#/$defs/money", "description": "당월 신규 세전 발생액" },
                        "pre_tax_balance_incl_carry": { "$ref": "#/$defs/money", "description": "이월 포함 세전 처리잔액(표시용)" },
                        "mmg_basis_1_1": { "$ref": "#/$defs/money", "description": "P1.1 순수 신규 R/S" },
                        "own_holder_output": { "$ref": "#/$defs/money", "description": "자사 권리자 산출액(재원 한도, 발생액 아님)" },
                        "consignment": { "type": "object", "properties": { "monthly_sales": { "$ref": "#/$defs/money", "description": "월 판매대금" }, "net_before_fee_vat": { "$ref": "#/$defs/money", "description": "수수료 부가세 차감 전 위탁 순액" }, "fee_supply": { "$ref": "#/$defs/money", "description": "위탁 수수료 공급가액" }, "consignment_input": { "$ref": "#/$defs/money", "description": "위탁 정산 입력액" } } }
                      }
                    },
                    "MMG_ADJ": {
                      "type": "object",
                      "properties": {
                        "mmg_amount": { "$ref": "#/$defs/money" },
                        "adjusted_1_1": { "$ref": "#/$defs/money", "description": "보정 후 P1.1 세전액" },
                        "mmg_subsidy": { "$ref": "#/$defs/money", "description": "MMG 보전금(mmg_subsidy_ledger)" },
                        "mmg_promo_overlap_flag": { "type": "boolean", "description": "[03-DD]" }
                      }
                    },
                    "DEDUCT": {
                      "type": "object",
                      "properties": {
                        "net_lines": { "type": "array", "items": { "$ref": "#/$defs/line_amount" }, "description": "환불 · 프로모션 반영 후 라인별 세전 순액" },
                        "refund_deduct_1_1": { "$ref": "#/$defs/money" }, "optB_deduct_1_1": { "$ref": "#/$defs/money" }, "optC_deduct_1_1": { "$ref": "#/$defs/money" },
                        "return_deduct_2_1": { "$ref": "#/$defs/money" }, "return_deduct_2_2": { "$ref": "#/$defs/money" },
                        "consignment_balance_applied": { "$ref": "#/$defs/money", "description": "1단계 위탁 전용 잔액 상쇄분" },
                        "support_deduct_total": { "type": "array", "items": { "type": "object", "properties": { "agreement_id": { "type": "string" }, "refund_5_1": { "$ref": "#/$defs/money" }, "optB_5_1": { "$ref": "#/$defs/money" }, "optC_5_1": { "$ref": "#/$defs/money" }, "total": { "$ref": "#/$defs/money" } } } },
                        "deduct_components": { "type": "array", "items": { "type": "object", "properties": { "ref_id": { "type": "string" }, "line_key": { "$ref": "#/$defs/line_key" }, "path": { "type": "string", "enum": ["UNPAID_REDUCTION", "PAID_RETURN"] }, "amount": { "$ref": "#/$defs/money" }, "snapshot_payee_splits": { "type": "array" } } } },
                        "return_claims": { "type": "array", "items": { "type": "object", "properties": { "ref_id": { "type": "string" }, "payee_id": { "type": "string" }, "post_tax_amount": { "$ref": "#/$defs/money" } } }, "description": "기지급 소득 반환채권 후보(10단계 전달)" }
                      }
                    },
                    "SUPPORT_CAP": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "agreement_id": { "type": "string" }, "cap_type": { "type": "string" },
                          "accrued_amount": { "$ref": "#/$defs/money", "description": "[03-DD] 당월 발생액" },
                          "restore_amount": { "$ref": "#/$defs/money", "description": "승인된 한도 복원액" },
                          "avail_cap": { "oneOf": [{ "$ref": "#/$defs/money" }, { "type": "null" }], "description": "복원 후 사용가능 한도" },
                          "new_confirmed": { "$ref": "#/$defs/money", "description": "당월 지원금 신규 확정액" },
                          "expired_excess": { "$ref": "#/$defs/money", "description": "한도 초과 소멸분" },
                          "confirmed_amount": { "$ref": "#/$defs/money", "description": "[03-DD] 당월 지원금 지급 대상 확정액" },
                          "confirmed_net_total": { "$ref": "#/$defs/money", "description": "[03-DD]" },
                          "cap_consumed_amount": { "oneOf": [{ "$ref": "#/$defs/money" }, { "type": "null" }], "description": "[03-DD]" },
                          "cash_paid_total": { "$ref": "#/$defs/money", "description": "[03-DD] 입력값 유지" },
                          "remaining_cap": { "oneOf": [{ "$ref": "#/$defs/money" }, { "type": "null" }], "description": "[03-DD]" },
                          "lump_settle_applied": { "$ref": "#/$defs/money" },
                          "status_before": { "type": "string" }, "status_after": { "type": "string" },
                          "own_distributable": { "$ref": "#/$defs/money", "description": "자사 배분가능액" },
                          "own_remaining": { "$ref": "#/$defs/money", "description": "자사 최종 잔여액" }
                        }
                      }
                    },
                    "PREPAY_OFFSET": {
                      "type": "object",
                      "properties": {
                        "prepayment_tax_type": { "type": ["string", "null"] },
                        "offset_eligible_lines": { "type": "array", "items": { "type": "object", "properties": { "line_key": { "$ref": "#/$defs/line_key" }, "eligible": { "$ref": "#/$defs/money" }, "offset": { "$ref": "#/$defs/money" } } } },
                        "offset_eligible_total": { "$ref": "#/$defs/money", "description": "상계 대상 세전액" },
                        "offset_withholding_equiv": { "$ref": "#/$defs/money", "description": "상계 대상 원천세 상당액" },
                        "offset_capacity": { "$ref": "#/$defs/money", "description": "상계 가능액" },
                        "offset_amount": { "$ref": "#/$defs/money", "description": "당월 상계액(예정, 9단계 재검증 후 값)" },
                        "offset_amount_initial": { "$ref": "#/$defs/money", "description": "1차 산정 상계액" },
                        "prepay_balance_before": { "$ref": "#/$defs/money" },
                        "prepay_balance_after": { "$ref": "#/$defs/money", "description": "갱신 예정 선급금 잔액" },
                        "taxable_reduction_flag": { "type": "boolean", "description": "과세표준 차감 여부(EARNED)" }
                      }
                    },
                    "LUMPSUM_ADD": {
                      "type": "object",
                      "properties": {
                        "lines": { "type": "array", "items": { "type": "object", "properties": { "milestone_id": { "type": "string" }, "item_kind": { "type": "string" }, "line_key": { "$ref": "#/$defs/line_key" }, "amount": { "$ref": "#/$defs/money" }, "payee_id": { "type": ["string", "null"] } } } },
                        "lumpsum_total": { "$ref": "#/$defs/money", "description": "비정기 가산금" },
                        "pre_split_supply": { "$ref": "#/$defs/money", "description": "분할 전 정산 공급가액(상계 전)" }
                      }
                    },
                    "PAYEE_SPLIT": {
                      "type": "object",
                      "properties": {
                        "payee_split_base": { "$ref": "#/$defs/money", "description": "[03-DD] 수취인 분할 기준액(표시용)" },
                        "splits_used": { "type": "array", "items": { "type": "object", "properties": { "payee_id": { "type": "string" }, "split_ratio": {} } } }
                      }
                    }
                  }
                },
                "payees": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["payee_id"],
                    "properties": {
                      "payee_id": { "type": "string" },
                      "lines": {
                        "type": "array",
                        "description": "8 · 9단계 payee × 라인 결과",
                        "items": {
                          "type": "object",
                          "properties": {
                            "line_key": { "$ref": "#/$defs/line_key" },
                            "origin": { "type": "string", "enum": ["NEW", "DEDUCT_SNAPSHOT", "CARRY_PRE_TAX", "CONSIGNMENT", "ADJUSTMENT"] },
                            "split_amount": { "$ref": "#/$defs/money", "description": "payee별 분할액" },
                            "offset_amount": { "$ref": "#/$defs/money", "description": "귀속 선급금 상계액" },
                            "pre_tax_payable": { "$ref": "#/$defs/money", "description": "당월 신규 세전 지급액" },
                            "taxable_base": { "$ref": "#/$defs/money", "description": "[03-DD]" },
                            "pending_negative_base": { "$ref": "#/$defs/money", "description": "[03-DD]" },
                            "protected_yn": { "type": "boolean", "description": "상계 비대상 보호분" },
                            "matrix_case_id": { "type": ["string", "null"], "description": "[03-DD]" },
                            "tax_decision_status": { "type": "string", "enum": ["DECIDED", "PENDING_REVIEW"], "description": "[03-DD]" },
                            "supply_amount": { "$ref": "#/$defs/money", "description": "공급가액" },
                            "vat_amount": { "$ref": "#/$defs/money", "description": "부가가치세" },
                            "income_tax": { "$ref": "#/$defs/money", "description": "소득세" },
                            "local_income_tax": { "$ref": "#/$defs/money", "description": "지방소득세" },
                            "withholding_total": { "$ref": "#/$defs/money", "description": "라인 총 원천징수세액" },
                            "deemed_expense": { "$ref": "#/$defs/money" }, "other_income_amount": { "$ref": "#/$defs/money" },
                            "threshold_exempt_yn": { "type": "boolean" }, "small_amount_exempt_yn": { "type": "boolean" },
                            "net_settle_line": { "$ref": "#/$defs/money", "description": "라인 실정산액" },
                            "after_tax_amount": { "$ref": "#/$defs/money", "description": "원귀속 PRE_TAX 세후 환산액(CARRY_PRE_TAX 행)" },
                            "consignment_fee_vat": { "$ref": "#/$defs/money", "description": "위탁 수수료 부가세" },
                            "correction_channels": { "type": "array", "items": { "type": "string" }, "description": "[03-DD]" }
                          }
                        }
                      },
                      "TAX": {
                        "type": "object",
                        "properties": {
                          "pre_tax_payable_total": { "$ref": "#/$defs/money", "description": "당월 신규 세전 지급액 합계" },
                          "taxable_base_total": { "$ref": "#/$defs/money" },
                          "vat_total": { "$ref": "#/$defs/money" },
                          "income_tax_total": { "$ref": "#/$defs/money" }, "local_income_tax_total": { "$ref": "#/$defs/money" },
                          "withholding_total": { "$ref": "#/$defs/money", "description": "원천세 합계" },
                          "consignment_settle_amount": { "$ref": "#/$defs/money", "description": "위탁 실정산액" },
                          "net_settle_amount": { "$ref": "#/$defs/money", "description": "payee별 당월 9단계 실정산액" },
                          "net_settle_offsettable": { "$ref": "#/$defs/money", "description": "상계 허용분" },
                          "net_settle_protected": { "$ref": "#/$defs/money", "description": "비상계 보호분" },
                          "carry_pre_tax_after_tax_total": { "$ref": "#/$defs/money", "description": "원귀속 PRE_TAX 세후 환산액 합계" },
                          "pending_review_lines": { "type": "integer" }
                        }
                      },
                      "CLAIM": {
                        "type": "object",
                        "properties": {
                          "clawback_amount": { "$ref": "#/$defs/money", "description": "전속계약금 일할 반환액(세후)" },
                          "clawback_offset_consent_yn": { "type": "boolean" },
                          "net_after_return": { "$ref": "#/$defs/money", "description": "반환 반영 후 당월 순액" },
                          "unoffset_prepay_claim": { "$ref": "#/$defs/money", "description": "만료 · 해지 미상계 선급금 청구 전환액" },
                          "return_claims_applied": { "$ref": "#/$defs/money", "description": "기지급 소득 반환채권 반영액(잠정, Q-19)" },
                          "claim_negative_net": { "$ref": "#/$defs/money", "description": "청구 대상 음수 순액" },
                          "force_claim": { "type": "boolean", "description": "강제 청구 트리거" },
                          "claim_issued_yn": { "type": "boolean", "description": "청구서 발행 여부" },
                          "claim_amount": { "$ref": "#/$defs/money", "description": "청구 · 반환채권 확정액" },
                          "claim_carry_rows": { "type": "array", "items": { "$ref": "#/$defs/carry_row_out" }, "description": "세무 상태별 청구 이월 적재" },
                          "consignment_balance_rows": { "type": "array", "items": { "$ref": "#/$defs/carry_row_out" }, "description": "위탁 음수 → 위탁 전용 잔액" },
                          "payable_net_for_payout": { "$ref": "#/$defs/money", "description": "지급 판정 전달 당월 지급채무 순액" },
                          "prepay_ledger_status_on_lock": { "type": ["string", "null"], "enum": ["CLAIMED_ON_TERMINATION", null] },
                          "december_review_flag": { "type": "boolean" }
                        }
                      },
                      "PAYOUT": {
                        "type": "object",
                        "properties": {
                          "evaluated": { "type": "boolean" },
                          "carry_post_tax_pos_total": { "$ref": "#/$defs/money", "description": "1단계 세후 지급대기액" },
                          "payout_judgement_amount": { "$ref": "#/$defs/money", "description": "판정 금액(VAT 포함)" },
                          "min_payout_limit": { "$ref": "#/$defs/money" },
                          "force_settle": { "type": "boolean" },
